@model IEnumerable<PowerGym.Models.Membresia>
<h1>Gestión de membresías - POWER GYM</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<a asp-action="Create" class="btn btn-primary mb-3">Registrar membresía</a>

<table class="table table-striped table-hover">
<thead class="table-dark">
<tr>
<th>Socio</th><th>Documento</th><th>Plan</th>
<th>Inicio</th><th>Fin</th><th>Precio</th><th>Estado</th><th>Acciones</th>
</tr>
</thead>
<tbody>
@foreach (var m in Model)
{
<tr>
<td>@m.NombreSocio</td>
<td>@m.Documento</td>
<td>@m.NombrePlan</td>
<td>@m.FechaInicio.ToString("dd/MM/yyyy")</td>
<td>@m.FechaFin.ToString("dd/MM/yyyy")</td>
<td>Bs. @m.PrecioAplicado.ToString("N2")</td>
<td>@m.Estado</td>
<td>
@if (m.Estado == "ACTIVA")
{
<form asp-action="Cancelar" asp-route-id="@m.IdMembresia" method="post"
      onsubmit="return confirm('¿Cancelar esta membresía?');">
<button class="btn btn-sm btn-danger">Cancelar</button>
</form>
}
</td>
</tr>
}
@if (!Model.Any())
{
<tr><td colspan="8" class="text-center">No existen membresías registradas.</td></tr>
}
</tbody>
</table>
